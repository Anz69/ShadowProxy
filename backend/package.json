  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:release-scripts": "node --test scripts/lib/*.test.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/migrate-deploy.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "script:luna-to-mango": "node scripts/luna-to-mango-migrate.js",
    "script:mango-audit": "node scripts/mango-traffic-reconcile.js audit",
    "script:mango-zero": "node scripts/mango-traffic-reconcile.js zero",
    "script:mango-restore": "node scripts/mango-traffic-reconcile.js restore",
    "script:gateway-audit": "node scripts/gateway-audit.js",
    "script:gateway-smoke": "node scripts/gateway-provider-smoke.js",
    "script:proxy-test": "node scripts/proxy-test.js"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
