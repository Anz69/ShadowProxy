# Backend (NestJS) env — copy to backend/.env and fill real values.
# Never commit the real .env.

# Database / cache
POSTGRES_URI=postgres://user:password@postgres:5432/shadowproxy
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_ENABLED=true

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Sessions / cookies
SESSION_SECRET=change_me
SESSION_MAX_AGE=86400000
COOKIE_SECRET=change_me
COOKIE_DOMAIN=localhost

# Auth providers
RECAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_NAME=

# Mailing (SMTP)
MAILING_HOST=
MAILING_PORT=
MAILING_LOGIN=
MAILING_PASSWORD=

# Payments
CRYPTO_BOT_API_KEY=
HELEKET_API_KEY=
HELEKET_MERCHANT=
PAYMENT_LIFETIME=3600

# Proxy providers
PROXYEMPIRE_API_KEY=
SUB_API_KEY=
LTE_SOCKS_API_KEY=
LTE_SOCKS_BASE_URL=
LUNA_PROXY_APP_KEY=
LUNA_PROXY_NEEK=
LUNA_PROXY_BASE_URL=
MANGO_PROXY_API_KEY=
MANGO_PROXY_BASE_URL=
MANGO_API_TIMEOUT_MS=8000
FLASH_ISP_EU_HOST=eu-isp.flashproxy.io
FLASH_ISP_EU_HTTP_PORT=30
FLASH_ISP_EU_USERNAME=
FLASH_ISP_EU_PASSWORD=
FLASH_ISP_USA_HOST=beta.flashproxy.io
FLASH_ISP_USA_HTTP_PORT=30
FLASH_ISP_USA_USERNAME=
FLASH_ISP_USA_PASSWORD=
FLASH_RESIDENTIAL_LITE_HOST=lite.flashproxy.io
FLASH_RESIDENTIAL_LITE_HTTP_PORT=6969
FLASH_RESIDENTIAL_LITE_USERNAME=
FLASH_RESIDENTIAL_LITE_PASSWORD=
PROXY_NINE_TWO_TWO_API_TOKEN=
PROXY_NINE_TWO_TWO_API_PASSWORD=
ISP_PROXY_LIFETIME=

# Feature flags
USE_NODE_GATEWAY=false
MANGO_MODE=api
# Публичный DNS gateway без протокола/порта. Пусто = отдавать IP выбранной ноды.
PROXY_PUBLIC_HOST=
ENABLE_LEGACY_MOBILE_GB=false
ENABLE_MANGO_SYNC=false
ENABLE_PROXYEMPIRE_USAGE_SYNC=false
# Separate opt-in: creates missing upstream sub-users; keep off for usage-only reconciliation.
ENABLE_PROXYEMPIRE_BACKFILL=false
